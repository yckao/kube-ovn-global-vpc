{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^ @]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "cliImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^ @]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          }
        },
        "required": [
          "name"
        ]
      },
      "minItems": 0
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preDeleteCheck": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "resources": {
      "type": "object"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registryNamespace": {
          "type": "string"
        },
        "networkClasses": {
          "type": "object",
          "required": [
            "default"
          ],
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "transportProfile": {
                "enum": [
                  "wireguard-bgp",
                  "geneve-bgp",
                  "vxlan-evpn"
                ]
              }
            },
            "required": [
              "transportProfile"
            ]
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "region": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "site": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "dc": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "bindingNamespace": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "allowedProjects": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                  "maxLength": 63
                },
                "minItems": 1
              },
              "cidrPools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "name",
              "region",
              "site",
              "dc",
              "bindingNamespace",
              "allowedProjects",
              "cidrPools"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "networkClasses",
        "locations"
      ]
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "User",
                    "Group",
                    "ServiceAccount"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "namespace": {
                  "type": "string"
                },
                "apiGroup": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "name"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "namespace",
          "subjects"
        ]
      },
      "minItems": 0
    },
    "locationAccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceAccountName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "createNamespaces": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "image",
    "cliImage",
    "platform"
  ],
  "$schema": "https://json-schema.org/draft-07/schema#"
}
